FROM {{BASEIMG}}

# ビルド情報。イメージの素性を後から追跡するために利用する。
ARG DENV_VERSION=unknown
ARG DENV_REVISION=unknown
ARG DENV_CREATED=unknown
ENV DENV_BASEIMG="{{BASEIMG}}"

# 対話プロンプトでビルドが止まらないようにする。
# ARGにしているのはビルド時のみ有効にするため。ENVだと実行時にも残り、
# コンテナ内で対話的にapt-getを使ったときに挙動が変わってしまう。
ARG DEBIAN_FRONTEND=noninteractive

# 環境別に切り替えるpipのインデックス。指定はビルドスクリプト側で行う。
# Jetson向けにはjetson-ai-lab(devpi)を指定する。
# このインデックスはPyPIをミラーしているため、
# Jetson固有のwheelも通常のパッケージも同じインデックスから取得できる。
# 未指定ならPyPIを使う。
#
# uvはPIP_INDEX_URLを読まないため、同じ値をUV_DEFAULT_INDEXにも設定して揃える。
# 未指定時の https://pypi.org/simple は pip と uv の既定値そのものであり、
# 指定しない場合の挙動は変わらない。
#
# poetryは対象外である。2.x で POETRY_PYPI_MIRROR_URL が廃止され、
# 参照先PyPIをイメージ側から差し替える手段が無くなったため。
# プロジェクト単位での指定方法は docs/rebuild.md を参照。
ARG DENV_PIP_INDEX_URL=""
ENV PIP_INDEX_URL="${DENV_PIP_INDEX_URL:-https://pypi.org/simple}"
ENV UV_DEFAULT_INDEX="${DENV_PIP_INDEX_URL:-https://pypi.org/simple}"

# lsb-release は次の層の lsb_release で使う。
# software-properties-common の依存で入ってはいるが、暗黙依存にはしない。
# unzip も同様に zip の Recommends で入るだけのため、明示的に指定する。
# apt lists はこの層で消しておく。後段で消してもこの層には残ってしまうため。
#
# ベースイメージ(slim)は最小構成であり、開発で当然に使うコマンドが入っていない。
# 特に procps が無いと ps / top / free / kill / pgrep が一切使えず、
# remote系の環境では常駐プロセスの状態を見る手段がコンテナ内に無くなる。
# エディタが1つも無いと EDITOR 未設定時に git がフォールバックする vi も
# 解決できず、git commit / rebase -i がコンテナ内で完結しない。
#
# パッケージは以下の意図で並べている。
#   取得・展開      : curl wget p7zip-full zip unzip zstd
#   ビルド・言語系  : build-essential cmake pkg-config sqlite3
#   VCS             : git git-lfs subversion
#   プロセス/調査   : procps psmisc lsof file htop
#   ネットワーク    : iputils-ping net-tools iproute2 dnsutils
#   転送            : rsync
#   エディタ        : vim-tiny nano
#   作業支援        : tree ripgrep tmux bash-completion shellcheck
#   DBクライアント  : default-mysql-client postgresql-client
#   その他          : software-properties-common gnupg sudo
#                     ffmpeg sox jq gettext-base lsb-release ca-certificates
#
# net-tools (netstat / ifconfig) は非推奨だが、慣れの問題で残している。
# 現行の iproute2 (ip / ss) を併せて入れ、どちらでも調べられる状態にする。
#
# エディタは vim-tiny と nano のみとする。
# vim-tiny は vi と editor(alternatives) を提供するため外せない。
# フル版の vim は個人設定に属するものとして入れない。必要なら各自で導入すること。
#
# cmake / pkg-config は wheel が無いパッケージをソースからビルドするときに要る。
# build-essential だけでは足りない場面があるため併せて入れる。
#
# shellcheck は scripts/ 配下のシェルスクリプトを手元で検査するために入れている
# (CIでのビルドは採用しない方針のため、静的チェックはこのイメージ上で行う)。
#
# man-db は入れない。slimベースが path-exclude で man ページ本体を除いており、
# 導入してもコマンドだけが増えて内容が読めないため。
RUN apt-get update && apt-get install -y \
    curl wget p7zip-full zip unzip zstd \
    build-essential cmake pkg-config sqlite3 \
    git git-lfs subversion \
    procps psmisc lsof file htop \
    iputils-ping net-tools iproute2 dnsutils \
    rsync \
    vim-tiny nano \
    tree ripgrep tmux bash-completion shellcheck \
    software-properties-common gnupg sudo default-mysql-client postgresql-client \
    ffmpeg sox jq gettext-base lsb-release ca-certificates \
&&  apt-get clean && rm -rf /var/lib/apt/lists/*

# 信頼ストアへ追加する証明書。詳細と削除の判断基準は docs/certificates.md を参照。
#
# JPRSは2026年6月17日以降に発行するサーバー証明書を
# 新ルート「SECOM TLS RSA Root CA 2024」の系統へ切り替えたが、
# このルートはまだ ca-certificates に収録されていない。
# そのため新ルートを既存の Security Communication RootCA2 で
# クロス署名した証明書を追加し、検証できるようにする。
#
# これは ca-certificates が新ルートを収録するまでの暫定措置である。
COPY resources/certs/ /usr/local/share/ca-certificates/
RUN update-ca-certificates

RUN curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor | tee /usr/share/keyrings/hashicorp-archive-keyring.gpg >/dev/null \
&&  gpg --no-default-keyring --keyring /usr/share/keyrings/hashicorp-archive-keyring.gpg --fingerprint \
&&  echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list \
&&  apt-get update && apt-get install -y terraform \
&&  apt-get clean && rm -rf /var/lib/apt/lists/* \
&&  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o "awscliv2.zip" \
&&  7z x awscliv2.zip \
&&  ./aws/install \
&&  rm -rf ./aws \
&&  rm awscliv2.zip

# docker CLI。コンテナ内から docker コマンドを使えるようにする。
# 導入するのはクライアントだけで、コンテナ内でデーモンは動かさない。
# ホストの /var/run/docker.sock をマウントしてホスト側のデーモンを操作する
# (docker-outside-of-docker)。マウント定義とその注意点は docs/docker.md を参照。
#
# ディストリビューションとアーキテクチャはベースイメージによって変わるため、
# テンプレートの置換ではなくビルド時に os-release と dpkg から解決する。
# (ビルドスクリプトの sed がこのファイルを置換するため、
#  コメント中にもプレースホルダの文字列は書かないこと)
# (Debian系以外のベースイメージを使う場合はこの層の見直しが要る)
RUN . /etc/os-release \
&&  install -m 0755 -d /etc/apt/keyrings \
&&  curl -fsSL "https://download.docker.com/linux/${ID}/gpg" -o /etc/apt/keyrings/docker.asc \
&&  chmod a+r /etc/apt/keyrings/docker.asc \
&&  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/${ID} ${VERSION_CODENAME:-$(lsb_release -cs)} stable" > /etc/apt/sources.list.d/docker.list \
&&  apt-get update \
&&  apt-get install -y docker-ce-cli docker-buildx-plugin docker-compose-plugin \
&&  apt-get clean && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://get.volta.sh | bash \
&&  /root/.volta/bin/volta install node pnpm

# Ubuntu 24.04系のベースイメージはPEP 668によりpip installが拒否されるため
# --break-system-packagesが要る。ただし古いpipはこのオプションを持たないので、
# 対応している場合のみ付与する。
RUN pip_opts="--no-cache-dir"; \
    if pip install --help 2>/dev/null | grep -q -- --break-system-packages; then \
        pip_opts="$pip_opts --break-system-packages"; \
    fi \
&&  pip install $pip_opts \
    poetry \
    boto3 \
    twine \
    setuptools_scm \
    python-dotenv[cli] \
    taskipy \
    uv

# session-manager-pluginの配布パスはAWS独自の名前になっているため対応表が要る。
# AWS CLI側は uname -m (x86_64 / aarch64) がそのまま使える。
RUN case "$(dpkg --print-architecture)" in \
        amd64) ssm_arch=ubuntu_64bit ;; \
        arm64) ssm_arch=ubuntu_arm64 ;; \
        *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
&&  curl -fsSL "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/${ssm_arch}/session-manager-plugin.deb" -o "session-manager-plugin.deb" \
&&  dpkg -i session-manager-plugin.deb \
&&  rm session-manager-plugin.deb

# 独自のシェル設定は /root/.bash_aliases として置き、.bashrc から読ませる。
# 以前は bash_aliases を /root/.bashrc として COPY していたが、
# これはベースイメージ側の .bashrc を丸ごと消してしまっていた。
# ファイル名と配置先が一致していない点も紛らわしかった。
#
# Debian系の .bashrc が持つ ~/.bash_aliases という拡張点に合わせることで、
# ベースイメージ側の .bashrc の内容を壊さずに自分の設定だけを足せる。
# (ベースイメージによってはこの読み込みが無いため、追記は自前で行う)
#
# 追記先は .bashrc の末尾とする。ベースイメージ側で PS1 等が設定されていても、
# 後から読まれるこちらが優先される。
# >> なので .bashrc を持たないベースイメージでは新規作成になる。
COPY resources/bash_aliases /root/.bash_aliases
RUN printf '%s\n' \
    '' \
    '# devenviron の共通設定。' \
    'if [ -f ~/.bash_aliases ]; then' \
    '    . ~/.bash_aliases' \
    'fi' \
    >> /root/.bashrc

COPY resources/ssh-aws.sh /usr/local/bin/ssh-aws.sh
COPY resources/ssh-fw-aws.sh /usr/local/bin/ssh-fw-aws.sh
COPY resources/devenviron-manifest /usr/local/bin/devenviron-manifest

# voltaで導入したnode/pnpmを非対話シェルからも参照できるようにする。
# (従来はシェル設定でのみPATHを通していたため`docker run <image> node -v`が失敗していた)
ENV VOLTA_HOME="/root/.volta"
ENV PATH="/root/.volta/bin:${PATH}"

# node と python(requests系) は既定でOSの信頼ストアを見ず、
# それぞれ独自のバンドルを使うため、追加した証明書が効かない。
# 参照先をOS側の信頼ストアへ揃える。
ENV SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"
ENV REQUESTS_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
ENV NODE_EXTRA_CA_CERTS="/usr/local/share/ca-certificates/SECOM_TLS_RSA_Root_CA_2024_cross.crt"

# ビルド時点の構成を記録する。必ず全ての導入処理の後に実行すること。
RUN chmod +x /usr/local/bin/devenviron-manifest \
&&  mkdir -p /etc/devenviron \
&&  devenviron-manifest > /etc/devenviron/manifest.txt

LABEL org.opencontainers.image.title="devenviron" \
      org.opencontainers.image.source="https://github.com/tamuto/devenviron" \
      org.opencontainers.image.version="${DENV_VERSION}" \
      org.opencontainers.image.revision="${DENV_REVISION}" \
      org.opencontainers.image.created="${DENV_CREATED}" \
      org.opencontainers.image.base.name="{{BASEIMG}}"

# ベースイメージのENTRYPOINTを解除する。
# [""]は空文字のENTRYPOINTを設定してしまうため、リセットには[]を使う。
ENTRYPOINT []
CMD ["/bin/bash"]
