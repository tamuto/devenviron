# 各自の定義。
#
#   cp docker-compose.yaml.sample docker-compose.yaml
#
# docker-compose.yaml は .gitignore してあるため、
# 自分の定義を書いてもコミットされない。
# 共通設定は compose.base.yaml 側にあり、そちらはリポジトリで管理する。
#
# ■ コンテナは待機するだけ。セッションは booth が起こす
#
# コンテナは sleep で待機し、Claude Code のセッションは
# booth (pnpx @infodb/booth) が中の tmux に作る。
# プロジェクトが増えてもこのファイルを編集する必要はない。
#
#   pnpx @infodb/booth open myproject   # /workspaces/myproject でセッションを起こす
#   pnpx @infodb/booth open another
#   pnpx @infodb/booth ls
#
# hostname はモバイルや claude.ai に表示されるデバイス名になる。
# 指定しないとコンテナ ID が表示されて判別できない。
# セッション名は booth 名がそのまま入るため、ここでは指定しない。
#
# container_name は指定しない。省略すると compose が
# <compose プロジェクト名>-<サービス名>-1 を自動で付ける。
# docker compose exec / run はサービス名で指定するため支障はない。

services:
  denv:
    extends:
      file: compose.base.yaml
      service: denv-cc-remote
    hostname: denv

  # --- デバイス名をプロジェクトごとに分けたい場合 ---
  #
  # claude.ai 上のデバイス名はコンテナの hostname なので、
  # 1 コンテナに同居させると全セッションで同じ名前になる。
  # 分けたい場合はプロジェクトごとにサービスを立て、
  # booth 側で service = "{name}" と書く。
  # コンテナが増えるぶんメモリを使うため、必要なものだけにするとよい。

  # another:
  #   extends:
  #     file: compose.base.yaml
  #     service: denv-cc-remote
  #   hostname: another

# extends では top-level の volumes は引き継がれないため、ここで宣言する。
volumes:
  serena-data:
